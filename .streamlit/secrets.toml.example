# Copy this file to .streamlit/secrets.toml and fill in your key.
# secrets.toml is in .gitignore - never commit your real key.

# Create a key at https://aistudio.google.com/apikey
# Google Search grounding needs billing enabled on that project (not available on the free tier).
GEMINI_API_KEY = "your-gemini-api-key"

# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL = "gemini-3.8-flash"
